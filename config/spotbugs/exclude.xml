<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 검출에서 뺄 것(0-22). 한 줄이 늘 때마다 왜 뺐는지를 같이 적는다 —
  근거 없는 제외가 쌓이면 게이트가 무엇을 막는지 아무도 모르게 된다(ProjectShop 과 같은 원칙).
  범위는 될 수 있는 대로 좁게(클래스·메서드까지). 유형을 통째로 빼면 앞으로 생길 것까지 숨는다.

  첫 측정(2026-09-26, 0-22 시점 코드): 13건. 셋은 코드로 고쳤다 —
  Migrator 버전 INSERT 문자열 조립 → PreparedStatement, JdbcMetaSource 생성자 예외 → 메타데이터를 쓸 때 얻기,
  Profile.CodeCheck 맵 노출 → 수정 불가 사본. 나머지가 아래다.
-->
<FindBugsFilter>

    <!--
      내장 H2(data/toolbox.mv.db)는 네트워크 리스너가 없고 접근 통제는 파일 권한이다.
      비밀번호를 두면 그것을 어딘가에 적어야 하는데 절대 규칙 2 가 비밀번호를 파일에 못 쓰게 한다.
      빈 비밀번호가 의도다. 사용자 DB 비밀번호(1-4)는 이 클래스를 안 지난다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.db.Db"/>
        <Or>
            <Method name="open"/>
            <Method name="connect"/>
        </Or>
        <Or>
            <Bug pattern="DMI_EMPTY_DB_PASSWORD"/>
            <Bug pattern="HARD_CODE_PASSWORD"/>
        </Or>
    </Match>

    <!--
      마이그레이션 SQL 은 classpath 의 db/migration/V###.sql(이 저장소 파일)이다. 사용자 입력이 아니다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.db.Migrator"/>
        <Method name="migrate"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <!--
      사용자가 쓴 SQL 을 사용자 권한으로 그대로 실행하는 도구다(1-7, 2.1 부산물·2.5 sql_snippets 실행). 입력 = 의도.
      값은 `?` 바인드로 넘기고, 이 메서드는 SQL·결과를 로그에 안 남긴다(절대 규칙 3). CodeQL 이 같은 자리를 잡으면 같은 사유로 dismiss.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.sqlrun.SqlRunner"/>
        <Method name="run"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <!--
      4-7 FK 부모 값 조회 `SELECT DISTINCT <refCols> FROM [<refSchema>.]<refTable> ORDER BY 1..n`.
      식별자는 바인드할 수 없어 이어 붙이되, 넣기 전에 전부 IDENT(`[A-Za-z_][A-Za-z0-9_$#]{0,127}`)로 검사하고
      하나라도 어긋나면 조회하지 않는다(InsertGenPostgresTest 가 실제 조회를 잰다). 값·결과는 로그에 안 남긴다(절대 규칙 3).
    -->
    <Match>
        <Class name="kr.ejg.toolbox.web.InsertRoutes"/>
        <Method name="fkValues"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>

    <!--
      MainTest 가 떠 있는 서버에 ping 하려고 쓰는 손잡이. 서버 객체를 감추면 테스트가 포트를 못 안다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.cli.Serve"/>
        <Method name="app"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!--
      JDBC 커넥션을 감싸 메타데이터를 읽는 것이 이 클래스의 일이다. 커넥션 수명은 부른 쪽이 쥔다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.meta.JdbcMetaSource"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      의존 주입 — 공유 서비스(ConnectionRegistry·SnapshotStore)를 들고 쓰는 것이 이 클래스의 일이다.
      복사하면 비밀번호 메모리가 둘로 갈린다(1-5).
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.meta.SnapshotService"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      기동 뒤 기본 브라우저 열기(`cmd /c start "" <url>`). url 은 상수 HOST 와 Javalin 이 준 포트 정수로만 만든다 —
      사용자 입력이 섞이는 경로가 없다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.web.App"/>
        <Or>
            <Method name="openBrowser"/>
            <Method name="bind"/>
        </Or>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>

    <!--
      오탐이다. compact 생성자가 Collections.unmodifiableMap(new LinkedHashMap<>(...)) 사본을 담는데
      SpotBugs 는 그것을 불변으로 못 알아본다. Map.copyOf 는 YAML 의 null 값(`rule:` 만 쓴 줄)에서 NPE 라 못 쓴다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.profile.Profile$CodeCheck"/>
        <Or>
            <Method name="groups"/>
            <Method name="rules"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!--
      위와 같은 오탐(5-2). 코드 검사 규칙 정의의 params 는 unmodifiableMap 사본이다. 값에 null 이 올 수 있어 Map.copyOf 를 못 쓴다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.check.Rule$Def"/>
        <Method name="params"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!--
      5-6a 형상 관리 명령. 셸을 거치지 않고(ProcessBuilder 인자 목록), 실행 파일은 Cli.EXECUTABLES(git·svn) 밖이면 던진다.
      인자는 상수와 WorkingCopy 가 검사한 ref(git `^[A-Za-z0-9][A-Za-z0-9._/~^@{}-]*$`·`..` 없음, svn 숫자·HEAD 류)뿐이다.
      프로세스를 띄우는 자리는 ArchitectureTest 가 이 클래스와 App 으로 묶는다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.vcs.Cli"/>
        <Method name="run"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>

    <!--
      포트가 비었나 미리 재는 소켓(127.0.0.1, 바로 닫는다). 데이터가 안 오간다.
      서버 자체도 루프백 전용이라 TLS 를 안 쓴다(PLAN 5-12).
    -->
    <Match>
        <Class name="kr.ejg.toolbox.web.App"/>
        <Method name="isFree"/>
        <Bug pattern="UNENCRYPTED_SERVER_SOCKET"/>
    </Match>

    <!--
      1-9 DTO 생성기는 XML 이 아니라 자바 소스 문자열을 만든다. javadoc 의 <p> 태그를 FindSecBugs 가 XML 조립으로 본다.
      주석을 닫는 */ 는 doc() 가 막는다(DtoGeneratorTest.namingRules), 결과는 컴파일로 검증한다.
    -->
    <Match>
        <Class name="kr.ejg.toolbox.core.gen.DtoGenerator"/>
        <Method name="generate"/>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
    </Match>

</FindBugsFilter>
