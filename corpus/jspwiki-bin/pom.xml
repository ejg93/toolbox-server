<?xml version="1.0" encoding="UTF-8"?>
<!--
  선택 표본 jspwiki-bin(V-29) — Apache JSPWiki 2.12.5 의 컴파일된 jar(Maven Central)와 그 의존성을 표본 폴더로 받는 레시피.
  소스 표본 jspwiki 가 같은 판(2.12.5)이라 SpotBugs·FindSecBugs 지적의 소스 줄 매핑을 잰다(5-38b SpotBugsCorpusTest).
  corpus-fetch.sh 가 받은 뒤 jspwiki-main jar 를 classes/ 로 풀고 나머지를 lib/ 로 옮긴다. 저장소·반입 묶음에 jar 를 넣지 않는다.
  받기: bash scripts/corpus-fetch.sh jspwiki-bin  (네트워크)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>toolbox.corpus</groupId>
  <artifactId>jspwiki-bin</artifactId>
  <version>1</version>
  <packaging>pom</packaging>

  <dependencies>
    <dependency>
      <groupId>org.apache.jspwiki</groupId>
      <artifactId>jspwiki-main</artifactId>
      <version>2.12.5</version>
    </dependency>
  </dependencies>
</project>
