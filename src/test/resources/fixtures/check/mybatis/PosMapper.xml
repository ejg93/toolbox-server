<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="NoSuchDAO">
  <select id="list" resultType="map">
    SELECT * FROM users
    <if test="sort != null">
      ORDER BY ${sort}
    </if>
  </select>
  <select id="list" resultType="map">
    SELECT id FROM users
  </select>
</mapper>
