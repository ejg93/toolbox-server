<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="NoSuchDAO">
  <select id="list" resultType="map">
    SELECT * FROM users
    <if test="sort != null">
      ORDER BY ${sort}
    </if>
  </select>
  <select id="list" resultType="map">
    SELECT id FROM users
  </select>
  <delete id="all">DELETE FROM T</delete>
  <update id="u">UPDATE T SET A = 1</update>
  <update id="lit">UPDATE T SET memo = 'where'</update>
  <select id="commented" resultType="map">
    SELECT id FROM users WHERE id = #{id} /* ${x} 블록 주석 */
      -- AND ${y} 줄 주석
    UNION SELECT /*+ INDEX(t ${ix}) */ id FROM t WHERE id = #{id}
  </select>
  <update id="subWhere">UPDATE users SET name = (SELECT n FROM other WHERE id = 1)</update>
  <select id="frag">SELECT /* a &lt; b */ * FROM t</select>
</mapper>
