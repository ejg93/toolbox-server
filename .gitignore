# 반입 드라이버·사람이 넣는 Tibero jar·라이선스 파일 — 전부 저장소 밖(8-9, PR #38 리뷰 4차)
drivers/
*.log
# 테스트 픽스처 로그는 입력이다(4-8 로그 SQL 복원)
!src/test/resources/fixtures/**/*.log
.lint-args

# 실제 사업 설정·발주처 양식은 커밋하지 않는다. 예시만 남긴다
profiles/*.yaml
!profiles/example.yaml
mappings/deliverable/*
!mappings/deliverable/example.yaml
templates/deliverable/*
!templates/deliverable/example/
rules/*.yaml
!rules/example.yaml

# 반입 zip
toolbox-server-*.zip

.claude/settings.local.json
.claude/explain-mode
.idea/
# 생성기 템플릿 세트 — 예시 둘만 커밋, 사업 세트는 로컬(7-5)
templates/gen/*
!templates/gen/egov35/
!templates/gen/egov5/
# 반입 재료(8-9) — 받은 것은 저장소 밖 바이너리. 지문은 bundle/MANIFEST
docs/javadoc/
